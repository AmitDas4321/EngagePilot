{
  "name": "EngagePilot",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--network-family-autoselection-attempt-timeout=2000' next dev --no-server-fast-refresh --turbopack",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "cross-env NODE_OPTIONS='--network-family-autoselection-attempt-timeout=2000' next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "worker": "cross-env NODE_OPTIONS='--network-family-autoselection-attempt-timeout=2000' tsx worker/dm-worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.54",
    "@ai-sdk/deepseek": "3.0.45",
    "@ai-sdk/google": "4.0.72",
    "@ai-sdk/groq": "^4.0.41",
    "@ai-sdk/openai": "^4.0.66",
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.7.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/query-persist-client-core": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "ai": "^7.0.99",
    "bullmq": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "goey-toast": "^0.5.0",
    "ioredis": "^5.11.1",
    "lightningcss": "^1.33.0",
    "motion": "^13.1.1",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "@parcel/watcher": "2.6.0",
    "prisma": {
      "mysql2": "^3.24.5"
    }
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  }
